# Capture nodes and modes normally come from /run/x1301/state.env. EVF_SOURCE
# is intentionally unset; use --source /dev/videoN only for diagnostics.
DISPLAY_BACKEND=st7735
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=128
DISPLAY_ROTATION=0
X1301_STATE_FILE=/run/x1301/state.env
X1301_STATUS_COMMAND=/usr/local/lib/x1301/runtime-status.sh
X1301_DIAGNOSTIC_COMMAND=/usr/local/lib/x1301/hdmi-status.sh
EVF_RECONNECT_DELAY=1.0
SHOW_FPS=1
SHOW_RESOLUTION=1
SHOW_CROSSHAIR=0
SHOW_HISTOGRAM=0
FOCUS_PEAKING=0
ZEBRA=0
EVF_CAPTURE_WIDTH=1920
EVF_CAPTURE_HEIGHT=1080
EVF_CAPTURE_FPS=30
EVF_CAPTURE_FOURCC=
EVF_MODE=fit
EVF_SPI_PORT=0
EVF_SPI_DEVICE=0
EVF_SPI_HZ=16000000
EVF_DC=24
EVF_RST=25
EVF_X_OFFSET=0
EVF_Y_OFFSET=0
EVF_ROTATION=0
EVF_GPIO_BACKEND=lgpio
EVF_OVERLAY=rec,fps,resolution,clock,crosshair
EVF_PEAKING_THRESHOLD=90
EVF_ZEBRA_THRESHOLD=245
EVF_LABEL=Z7
# Optional LAN monitor (disabled by default).
EVF_WEB=0
EVF_WEB_HOST=0.0.0.0
EVF_WEB_PORT=8080
# Optional active-low, pull-up buttons. Leave any or all unset.
EVF_BUTTON_F1_GPIO=
EVF_BUTTON_F2_GPIO=
EVF_BUTTON_F3_GPIO=
EVF_BUTTON_F4_GPIO=
EVF_BUTTON_MENU_GPIO=
EVF_BUTTON_DEBOUNCE=0.05
