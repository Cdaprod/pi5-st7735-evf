# Normally blank: the X1301 runtime state supplies the capture node.
EVF_SOURCE=
DISPLAY_BACKEND=st7735
DISPLAY_WIDTH=128
DISPLAY_HEIGHT=128
DISPLAY_ROTATION=0
X1301_STATE_FILE=/run/x1301/state.env
X1301_STATUS_COMMAND=hdmi-status.sh
SHOW_FPS=1
SHOW_RESOLUTION=1
SHOW_CROSSHAIR=0
SHOW_HISTOGRAM=0
FOCUS_PEAKING=0
ZEBRA=0
EVF_CAPTURE_WIDTH=1920
EVF_CAPTURE_HEIGHT=1080
EVF_CAPTURE_FPS=30
EVF_CAPTURE_FOURCC=
EVF_MODE=fit
EVF_SPI_PORT=0
EVF_SPI_DEVICE=0
EVF_SPI_HZ=16000000
EVF_DC=24
EVF_RST=25
EVF_X_OFFSET=0
EVF_Y_OFFSET=0
EVF_ROTATION=0
EVF_GPIO_BACKEND=lgpio
EVF_OVERLAY=rec,fps,resolution,clock,crosshair
EVF_PEAKING_THRESHOLD=90
EVF_ZEBRA_THRESHOLD=245
EVF_LABEL=Z7
