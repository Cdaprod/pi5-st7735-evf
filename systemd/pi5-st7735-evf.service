[Unit]
Description=Pi 5 ST7735 HDMI/CSI-2 EVF
After=multi-user.target x1301-hdmi-watch.service
Wants=x1301-hdmi-watch.service

[Service]
Type=simple
User=cdaprod
Group=cdaprod
WorkingDirectory=/home/cdaprod/Projects/pi5-st7735-evf
EnvironmentFile=-/home/cdaprod/Projects/pi5-st7735-evf/config/evf.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/cdaprod/Projects/pi5-st7735-evf/.venv/bin/python /home/cdaprod/Projects/pi5-st7735-evf/evf.py
Restart=on-failure
RestartSec=2
Nice=-5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target